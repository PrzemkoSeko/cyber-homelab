*.iso
*.ova
*.qcow2
*.vmdk
*.vdi

# Raw captures and logs (can include real IPs or credentials)
*.pcap
*.pcapng
*.log

# OS and editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
